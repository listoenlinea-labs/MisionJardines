[global]
type=global
endpoint_identifier_order=auth_username,username,ip

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0

; SIP del gateway sobre VPN privada. Reemplazar por la IP VPN DEL SERVIDOR.
[transport-gateway]
type=transport
protocol=udp
bind=REEMPLAZAR_IP_VPN_PBX:5060

; La extensión usada por el navegador. Misma clave en TELEFONIA_SIP_PASSWORD.
[caseta-web]
type=aor
max_contacts=1
remove_existing=yes

[caseta-web-auth]
type=auth
auth_type=userpass
username=caseta-web
password=REEMPLAZAR_PASSWORD_WEB

[caseta-web]
type=endpoint
transport=transport-wss
context=caseta-saliente
disallow=all
allow=ulaw,alaw
auth=caseta-web-auth
aors=caseta-web
webrtc=yes
dtls_auto_generate_cert=yes
direct_media=no
rtp_symmetric=yes
rewrite_contact=yes
force_rport=yes
; IP pública del PBX para ICE; puerto RTP accesible en el firewall.
media_address=REEMPLAZAR_IP_PUBLICA_PBX

; Cuenta SIP configurada en el puerto FXO del HT813. El gateway se registra aquí.
[fxo-gateway]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

[fxo-gateway-auth]
type=auth
auth_type=userpass
username=fxo-gateway
password=REEMPLAZAR_PASSWORD_FXO

[fxo-gateway]
type=endpoint
transport=transport-gateway
context=gateway-entrante
disallow=all
allow=ulaw,alaw
auth=fxo-gateway-auth
aors=fxo-gateway
direct_media=no
rtp_symmetric=yes
rewrite_contact=yes
force_rport=yes
