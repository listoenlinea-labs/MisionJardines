[Unit]
Description=Conmutador de caseta de Misión Jardines
Wants=network-online.target
Requires=asterisk.service
After=network-online.target asterisk.service

[Service]
User=asterisk
Group=asterisk
UMask=0077
EnvironmentFile=/etc/misionjardines-caseta.env
ExecStart=/usr/bin/python3 /opt/misionjardines-caseta/agente.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
