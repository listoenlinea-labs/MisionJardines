# Aplicación
# Telefonía: el interruptor hardcodeado está en src/config/telefonia.js.
# Vacíos mientras TELEFONIA_HABILITADA=false. Configurar antes de cambiarlo a true.
TELEFONIA_WSS_URL=
TELEFONIA_SIP_DOMAIN=
TELEFONIA_SIP_USER=caseta-web
TELEFONIA_SIP_PASSWORD=
# Opcionales para redes que requieren STUN/TURN. TURN necesita usuario y clave.
TELEFONIA_STUN_URL=
TELEFONIA_TURN_URL=
TELEFONIA_TURN_USER=
TELEFONIA_TURN_PASSWORD=

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://listoenlinea-labs.github.io
APP_BASE_URL=https://api-misionjardines.listoenlinea.host

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mision_jardines
DB_USER=mision_jardines
DB_PASSWORD=cambia_esta_contrasena

# Autenticación
JWT_SECRET=cambia_este_secreto

# Correo para recibos
# Puerto 465: SMTP_SECURE=true. Puerto 587: SMTP_SECURE=false.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=administracion@tu-dominio.com
SMTP_PASSWORD=cambia_esta_contrasena
SMTP_FROM_EMAIL=administracion@tu-dominio.com
SMTP_FROM_NAME=Administración Misión Jardines

# Datos bancarios que se muestran a los residentes en la sección Pagos.
PAGOS_BANCO=Nombre del banco
PAGOS_TITULAR=Titular de la cuenta
PAGOS_CUENTA=0000000000
PAGOS_CLABE=000000000000000000
PAGOS_REFERENCIA=Indica tu calle y número de casa

# Opcional: ruta absoluta del logotipo si el backend se despliega sin docs/.
# RECEIPT_LOGO_PATH=/ruta/al/logo-mision-jardines.png

# Llave larga y aleatoria para cifrar contraseñas de cámaras/plumas/telefonía en BD
CONNECTIONS_ENCRYPTION_KEY=

# URL completa de la página (incluye subcarpeta si existe), para invitaciones.
FRONTEND_APP_URL=https://listoenlinea-labs.github.io/MisionJardines

# Entorno en vivo: tráfico, incidencias y noticias
# Google Maps JavaScript API. Restringe esta key por HTTP referrer a tu GitHub Pages/dominio.
GOOGLE_MAPS_BROWSER_API_KEY=
# TomTom Traffic API para accidentes, cierres, obras y congestión cercanos.
TOMTOM_API_KEY=
# Opcional: dirección usada para centrar/geocodificar Misión Jardines.
MISION_JARDINES_ADDRESS=C. Atotonilco 700, 45138 Nuevo México, Zapopan, Jalisco, México

# ZKTeco C3-200 - conexión directa desde Hostinger por Port Forwarding.
# En producción usa la IPv4 pública/DDNS de Telmex y el puerto externo.
ZKTECO_CONNECTION_MODE=DIRECT
ZKTECO_DIRECT_HOST=
ZKTECO_DIRECT_PORT=44370
# Fallback/compatibilidad:
ZKTECO_HOST=192.168.1.201
ZKTECO_PORT=4370
ZKTECO_TIMEOUT_MS=7000
ZKTECO_AUTOSYNC_ENABLED=true
ZKTECO_AUTOSYNC_MS=30000
ZKTECO_COMM_PASSWORD=
ZKTECO_USERNAME=
ZKTECO_PASSWORD=
ZKTECO_AUTOBLOCK_DAY=11
# Mantener true hasta validar el cruce casa <-> numero de tarjeta.
ZKTECO_DRY_RUN=true

# Salidas/puertas del C3-200 que controlan la única pluma.
ZKTECO_GATE_OPEN_OUTPUTS=
# Déjalo vacío si la pluma cierra automáticamente y no existe un relé físico de cierre.
ZKTECO_GATE_CLOSE_OUTPUTS=
ZKTECO_GATE_PULSE_SECONDS=3


# Escrituras de personal/TAGs mediante Pull SDK oficial (recomendado para C3-200).
# El backend sigue leyendo y controlando relés directamente por TCP.
# El bridge puede correr en un Windows VPS/VM; no tiene que estar en la oficina.
ZKTECO_PULLSDK_BRIDGE_URL=
ZKTECO_PULLSDK_BRIDGE_TOKEN=
ZKTECO_PULLSDK_BRIDGE_TIMEOUT_MS=15000
